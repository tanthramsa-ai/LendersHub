# backend/.env — LOCAL DEV ONLY, and optional even then.
#
# IMPORTANT: dotenv does not overwrite a variable that is already set, and this
# file is loaded BEFORE the repo-root .env. Anything defined here therefore
# SHADOWS the real value in the root .env. A stale placeholder left in this file
# is what caused a production incident: maintenance scripts silently connected
# (or failed to connect) as the wrong user, surfacing as a confusing
# "password authentication failed for user postgres".
#
# On a deployed server you almost certainly want this file to NOT EXIST, so the
# repo-root .env is the single source of truth. Delete it rather than leaving
# placeholders in it.
#
# Note the app itself never reads this file in production: docker-compose passes
# env vars directly (which win over dotenv), and .dockerignore keeps .env out of
# the image entirely. This only affects scripts run on the host.

# Host-reachable DB URL, for maintenance scripts run OUTSIDE Docker
# (scripts/repair-tenant-schemas.js, scripts/check-tenant-schemas.js).
# Inside Compose the host is "db" on port 5432; from the VM host it is the
# published port, localhost:5433. Use real credentials from the root .env.
DATABASE_URL="postgresql://<user>:<password>@localhost:5433/lendershub"

# Leave unset here so the root .env / container env supplies the real one.
# Setting a placeholder here would shadow the real secret for host-run tooling.
# JWT_SECRET=
